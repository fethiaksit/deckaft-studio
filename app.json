{
  "expo": {
    "name": "DeckAft Studio",
    "slug": "deckaft-studio",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deckaft.studio"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#101317"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.deckaft.studio"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-system-ui"],
    "scheme": "deckaft",
    "backgroundColor": "#101317"
  }
}
