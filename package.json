{
  "name": "deckaft-studio",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "expo": "^58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.68.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "format:check": "prettier --check \"app/**/*.tsx\" \"src/**/*.ts\" \"src/**/*.tsx\" \"tests/*.ts\"",
    "export:native": "expo export --platform ios --platform android"
  },
  "private": true
